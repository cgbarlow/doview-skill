    },
    {
      "type": "text",
      "id": "frame-what-is-doview-content",
      "x": 20430,
      "y": 90,
      "width": 1540,
      "height": 700,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-what-is-doview",
      "roundness": null,
      "seed": 157612992,
      "version": 1,
      "versionNonce": 1953462418,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "A DoView is a visual diagram that shows the theory of change or outcomes model for an initiative, programme, or strategy. It maps the causal relationships between activities, outputs, and outcomes, flowing from left to right to show how earlier achievements lead to later results.\n\nDoView diagrams help stakeholders:\n- Understand the logic behind an initiative\n- Identify key outcomes and how they connect\n- Plan evaluation and monitoring activities\n- Communicate strategy clearly to diverse audiences\n\nFor more information, visit DoViewPlanning.org",
      "originalText": "A DoView is a visual diagram that shows the theory of change or outcomes model for an initiative, programme, or strategy. It maps the causal relationships between activities, outputs, and outcomes, flowing from left to right to show how earlier achievements lead to later results.\n\nDoView diagrams help stakeholders:\n- Understand the logic behind an initiative\n- Identify key outcomes and how they connect\n- Plan evaluation and monitoring activities\n- Communicate strategy clearly to diverse audiences\n\nFor more information, visit DoViewPlanning.org",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.15
    },
