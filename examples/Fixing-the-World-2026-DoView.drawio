    <diagram name="What is a DoView?" id="page-what-is-doview">
        <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title-what-is-doview" value="What is a DoView?" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Calibri;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="30" y="10" width="700" height="40" as="geometry"/></mxCell>
                <mxCell id="note-what-is-doview" value="Illustrative only –&lt;br&gt;Not created or endorsed by Dr Paul Duignan" style="text;html=1;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Calibri;fontSize=12;fontColor=#787878;" parent="1" vertex="1"><mxGeometry x="1310" y="10" width="280" height="60" as="geometry"/></mxCell>
                <mxCell id="footer-what-is-doview" value="DoView® is a registered trademark. Adapted from DoViewPlanning.org | Generated 2026-02-05" style="text;html=1;align=center;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontFamily=Calibri;fontSize=9;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="30" y="860" width="1540" height="30" as="geometry"/></mxCell>
                <mxCell id="text-what-is-doview" value="A DoView is a visual diagram that shows the theory of change or outcomes model for an initiative, programme, or strategy. It maps the causal relationships between activities, outputs, and outcomes, flowing from left to right to show how earlier achievements lead to later results.&lt;br&gt;&lt;br&gt;DoView diagrams help stakeholders:&lt;br&gt;• Understand the logic behind an initiative&lt;br&gt;• Identify key outcomes and how they connect&lt;br&gt;• Plan evaluation and monitoring activities&lt;br&gt;• Communicate strategy clearly to diverse audiences&lt;br&gt;&lt;br&gt;For more information, visit DoViewPlanning.org" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Calibri;fontSize=13;" parent="1" vertex="1"><mxGeometry x="30" y="90" width="1540" height="700" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
